---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  currentSlug: string;
  category?: string;
  limit?: number;
}

const { currentSlug, category, limit = 3 } = Astro.props;

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(post => post.id !== currentSlug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, limit);
---

{relatedPosts.length > 0 && (
  <section class="related-posts">
    <h3 class="related-title">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24" aria-hidden="true">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
      </svg>
      Sigue leyendo
    </h3>
    <div class="related-grid">
      {relatedPosts.map((post) => (
        <a href={`/blog/${post.id}/`} class="related-card">
          {post.data.heroImage && (
            <div class="related-image">
              <img 
                src={post.data.heroImage} 
                alt="" 
                loading="lazy"
                decoding="async"
              />
            </div>
          )}
          <div class="related-content">
            {post.data.category && (
              <span class="related-category">{post.data.category}</span>
            )}
            <h4 class="related-card-title">{post.data.title}</h4>
            <span class="related-date">
              <FormattedDate date={post.data.pubDate} />
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-posts {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(124, 106, 239, 0.2);
  }

  @media (min-width: 768px) {
    .related-posts {
      margin-top: 4rem;
      padding-top: 3rem;
    }
  }

  .related-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: white;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .related-title {
      gap: 0.75rem;
      font-size: 1.5rem;
      margin-bottom: 2rem;
    }
  }

  .related-title svg {
    color: #7C6AEF;
    width: 20px;
    height: 20px;
  }

  @media (min-width: 768px) {
    .related-title svg {
      width: 24px;
      height: 24px;
    }
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 480px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .related-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .related-card {
    display: flex;
    flex-direction: column;
    background: rgba(124, 106, 239, 0.05);
    border: 1px solid rgba(124, 106, 239, 0.1);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    transition: all 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .related-card:hover {
    border-color: #7C6AEF;
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(124, 106, 239, 0.15);
    text-decoration: none;
  }

  .related-card:active {
    transform: translateY(0);
  }

  .related-image {
    aspect-ratio: 16/9;
    overflow: hidden;
    background: #1A1A1A;
  }

  .related-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .related-card:hover .related-image img {
    transform: scale(1.05);
  }

  .related-content {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  @media (min-width: 768px) {
    .related-content {
      padding: 1.25rem;
      gap: 0.5rem;
    }
  }

  .related-category {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 700;
    color: #7C6AEF;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .related-card-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: white;
    line-height: 1.35;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .related-card-title {
      font-size: 1rem;
      line-height: 1.4;
    }
  }

  .related-date {
    font-size: 0.7rem;
    color: #888;
  }

  @media (min-width: 768px) {
    .related-date {
      font-size: 0.75rem;
    }
  }
</style>
