---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="logo">
			<span class="lightning">⚡</span> KÖD
		</a>
		<div class="nav-links">
			<HeaderLink href="/">Inicio</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/categorias/ia">IA</HeaderLink>
			<HeaderLink href="/categorias/negocios">Negocios</HeaderLink>
			<HeaderLink href="/categorias/tech">Tech</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://instagram.com/wearekod" target="_blank" aria-label="Instagram">
				<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
					<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
				</svg>
			</a>
			<a href="https://twitter.com/wearekod" target="_blank" aria-label="Twitter/X">
				<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
					<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		background: #1A1A1A;
		border-bottom: 1px solid #374151;
		padding: 0 1em;
		position: sticky;
		top: 0;
		z-index: 100;
	}
	
	nav {
		max-width: 1000px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1em 0;
	}
	
	.logo {
		font-size: 1.5em;
		font-weight: 700;
		color: white;
		text-decoration: none;
		display: flex;
		align-items: center;
		gap: 0.25em;
	}
	
	.logo:hover {
		text-decoration: none;
	}
	
	.lightning {
		color: #7C6AEF;
	}
	
	.nav-links {
		display: flex;
		gap: 0.5em;
	}
	
	.nav-links :global(a) {
		padding: 0.5em 1em;
		color: #E5E7EB;
		text-decoration: none;
		border-radius: 6px;
		transition: all 0.2s ease;
	}
	
	.nav-links :global(a:hover),
	.nav-links :global(a.active) {
		background: rgba(124, 106, 239, 0.1);
		color: #7C6AEF;
	}
	
	.social-links {
		display: flex;
		gap: 1em;
	}
	
	.social-links a {
		color: #9CA3AF;
		transition: color 0.2s ease;
	}
	
	.social-links a:hover {
		color: #7C6AEF;
	}
	
	@media (max-width: 768px) {
		.nav-links {
			display: none;
		}
		
		.social-links {
			display: none;
		}
	}
</style>
