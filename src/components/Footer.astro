<style>
	footer {
		background: #1A1A1A;
		border-top: 1px solid #374151;
		padding: 2rem 1rem 1.5rem;
		margin-top: 3rem;
	}
	
	@media (min-width: 768px) {
		footer {
			padding: 3rem 1rem 2rem;
			margin-top: 4rem;
		}
	}
	
	.footer-content {
		max-width: 1000px;
		margin: 0 auto;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid #374151;
	}
	
	@media (min-width: 768px) {
		.footer-content {
			display: grid;
			grid-template-columns: 1.5fr 1fr;
			gap: 3rem;
			padding-bottom: 2rem;
		}
	}
	
	/* Brand Section */
	.brand {
		margin-bottom: 2rem;
	}
	
	@media (min-width: 768px) {
		.brand {
			margin-bottom: 0;
		}
	}
	
	.brand-link {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 1.5rem;
		font-weight: 700;
		color: white;
		text-decoration: none;
		-webkit-tap-highlight-color: transparent;
	}
	
	.brand-link:hover {
		text-decoration: none;
	}
	
	.brand p {
		font-size: 0.9rem;
		font-weight: 400;
		color: #9CA3AF;
		margin: 0.5rem 0 0;
		line-height: 1.5;
	}
	
	.lightning {
		color: #7C6AEF;
	}
	
	/* Footer Grid */
	.footer-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
	}
	
	@media (min-width: 768px) {
		.footer-grid {
			gap: 2rem;
		}
	}
	
	.links, .social {
		display: flex;
		flex-direction: column;
	}
	
	.links h4, .social h4 {
		color: white;
		font-size: 0.85rem;
		font-weight: 600;
		margin-bottom: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	
	.links nav, .social nav {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	
	.links a, .social a {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: #9CA3AF;
		text-decoration: none;
		font-size: 0.875rem;
		padding: 0.375rem 0;
		transition: color 0.2s ease;
		-webkit-tap-highlight-color: transparent;
	}
	
	.links a:hover, .social a:hover {
		color: #7C6AEF;
		text-decoration: none;
	}
	
	/* Copyright */
	.copyright {
		max-width: 1000px;
		margin: 0 auto;
		padding-top: 1.5rem;
		text-align: center;
	}
	
	.copyright p {
		color: #6B7280;
		font-size: 0.8rem;
		margin: 0.25rem 0;
		line-height: 1.5;
	}
	
	@media (min-width: 768px) {
		.copyright {
			padding-top: 2rem;
		}
		
		.copyright p {
			font-size: 0.85rem;
		}
	}
	
	.copyright a {
		color: #7C6AEF;
		text-decoration: none;
		font-weight: 500;
	}
	
	.copyright a:hover {
		text-decoration: underline;
	}
</style>
