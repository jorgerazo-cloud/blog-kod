---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1><span class="lightning">⚡</span> KÖD Blog</h1>
				<p class="tagline">Noticias de IA, Tech y Marketing Digital que importan.</p>
				<p class="handle">Por <a href="https://instagram.com/wearekod" target="_blank" rel="noopener">@wearekod</a></p>
			</section>
			
			<section class="latest-posts">
				<h2>Últimas noticias</h2>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`} class="post-card">
									<div class="post-card-header">
										{post.data.category && (
											<span class="category">{post.data.category}</span>
										)}
										<span class="date">
											<FormattedDate date={post.data.pubDate} />
										</span>
									</div>
									<h3>{post.data.title}</h3>
									<p class="description">{post.data.description}</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
			
			<section class="cta">
				<h2>¿Quieres dominar la IA antes que tu competencia?</h2>
				<p>Síguenos en redes para más noticias que importan.</p>
				<div class="cta-buttons">
					<a href="https://instagram.com/wearekod" target="_blank" rel="noopener" class="btn primary">
						Seguir en Instagram
					</a>
					<a href="/blog" class="btn secondary">
						Ver todos
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	/* Hero Section - Mobile First */
	.hero {
		text-align: center;
		padding: 2rem 0 1.5rem;
		border-bottom: 1px solid #374151;
		margin-bottom: 2rem;
	}
	
	.hero h1 {
		font-size: 2rem;
		margin-bottom: 0.5rem;
		line-height: 1.2;
	}
	
	.lightning {
		color: #7C6AEF;
	}
	
	.hero .tagline {
		font-size: 1rem;
		color: #9CA3AF;
		margin: 0 0 0.75rem;
		line-height: 1.4;
	}
	
	.hero .handle {
		font-size: 0.9rem;
		color: #6B7280;
		margin: 0;
	}
	
	.hero .handle a {
		color: #7C6AEF;
		font-weight: 600;
	}
	
	@media (min-width: 480px) {
		.hero {
			padding: 2.5rem 0 2rem;
		}
		
		.hero h1 {
			font-size: 2.5rem;
		}
		
		.hero .tagline {
			font-size: 1.125rem;
		}
	}
	
	@media (min-width: 768px) {
		.hero {
			padding: 3.5rem 0 2.5rem;
			margin-bottom: 2.5rem;
		}
		
		.hero h1 {
			font-size: 3rem;
		}
		
		.hero .tagline {
			font-size: 1.25rem;
		}
		
		.hero .handle {
			font-size: 1rem;
			margin-top: 1rem;
		}
	}
	
	/* Latest Posts Section */
	.latest-posts {
		margin-bottom: 2rem;
	}
	
	.latest-posts h2 {
		font-size: 1.25rem;
		margin-bottom: 1rem;
		color: white;
	}
	
	@media (min-width: 768px) {
		.latest-posts h2 {
			font-size: 1.5rem;
			margin-bottom: 1.5rem;
		}
	}
	
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	
	.post-list li {
		margin-bottom: 0;
	}
	
	/* Post Card - Mobile First */
	.post-card {
		display: block;
		padding: 1rem;
		background: #1A1A1A;
		border: 1px solid #374151;
		border-radius: 12px;
		margin-bottom: 0.75rem;
		text-decoration: none;
		transition: all 0.2s ease;
		-webkit-tap-highlight-color: transparent;
	}
	
	.post-card:hover {
		border-color: #7C6AEF;
		transform: translateY(-2px);
		box-shadow: 0 4px 20px rgba(124, 106, 239, 0.15);
		text-decoration: none;
	}
	
	.post-card:active {
		transform: translateY(0);
	}
	
	@media (min-width: 768px) {
		.post-card {
			padding: 1.5rem;
			margin-bottom: 1rem;
		}
	}
	
	/* Post Card Header */
	.post-card-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 0.5rem;
		flex-wrap: wrap;
	}
	
	.category {
		display: inline-block;
		padding: 0.2rem 0.6rem;
		background: #7C6AEF;
		color: white;
		font-size: 0.65rem;
		font-weight: 700;
		text-transform: uppercase;
		border-radius: 4px;
		letter-spacing: 0.03em;
	}
	
	@media (min-width: 768px) {
		.category {
			font-size: 0.7rem;
			padding: 0.25rem 0.75rem;
		}
	}
	
	.post-card .date {
		color: #6B7280;
		font-size: 0.75rem;
	}
	
	@media (min-width: 768px) {
		.post-card .date {
			font-size: 0.85rem;
		}
	}
	
	.post-card h3 {
		color: white;
		font-size: 1.1rem;
		margin-bottom: 0.375rem;
		line-height: 1.3;
		font-weight: 600;
	}
	
	@media (min-width: 768px) {
		.post-card h3 {
			font-size: 1.25rem;
			margin-bottom: 0.5rem;
		}
	}
	
	.post-card .description {
		color: #9CA3AF;
		font-size: 0.875rem;
		margin: 0;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	
	@media (min-width: 768px) {
		.post-card .description {
			font-size: 0.95rem;
			-webkit-line-clamp: 3;
		}
	}
	
	/* CTA Section - Mobile First */
	.cta {
		text-align: center;
		padding: 2rem 1.25rem;
		background: #1A1A1A;
		border-radius: 16px;
		margin-top: 2rem;
		border: 1px solid #374151;
	}
	
	.cta h2 {
		font-size: 1.25rem;
		color: white;
		margin-bottom: 0.5rem;
		line-height: 1.3;
	}
	
	.cta p {
		color: #9CA3AF;
		margin-bottom: 1.5rem;
		font-size: 0.95rem;
	}
	
	@media (min-width: 480px) {
		.cta {
			padding: 2.5rem 2rem;
		}
		
		.cta h2 {
			font-size: 1.5rem;
		}
	}
	
	@media (min-width: 768px) {
		.cta {
			padding: 3.5rem 2rem;
			margin-top: 3rem;
		}
		
		.cta h2 {
			font-size: 1.75rem;
		}
		
		.cta p {
			font-size: 1rem;
			margin-bottom: 2rem;
		}
	}
	
	/* CTA Buttons */
	.cta-buttons {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		max-width: 280px;
		margin: 0 auto;
	}
	
	@media (min-width: 480px) {
		.cta-buttons {
			flex-direction: row;
			justify-content: center;
			max-width: none;
			gap: 1rem;
		}
	}
	
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.875rem 1.5rem;
		border-radius: 8px;
		font-weight: 600;
		font-size: 1rem;
		text-decoration: none;
		transition: all 0.2s ease;
		min-height: 48px;
		-webkit-tap-highlight-color: transparent;
	}
	
	.btn.primary {
		background: #7C6AEF;
		color: white;
	}
	
	.btn.primary:hover {
		background: #9D8FF2;
		text-decoration: none;
	}
	
	.btn.primary:active {
		background: #5B4BC7;
	}
	
	.btn.secondary {
		background: transparent;
		color: #7C6AEF;
		border: 2px solid #7C6AEF;
	}
	
	.btn.secondary:hover {
		background: rgba(124, 106, 239, 0.1);
		text-decoration: none;
	}
</style>
