---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1><span class="lightning">⚡</span> KÖD Blog</h1>
				<p>Noticias de IA, Tech y Marketing Digital que importan.</p>
				<p class="subtitle">Por <a href="https://instagram.com/wearekod" target="_blank">@wearekod</a></p>
			</section>
			
			<section class="latest-posts">
				<h2>Últimas noticias</h2>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`} class="post-card">
									{post.data.category && (
										<span class="category">{post.data.category}</span>
									)}
									<h3>{post.data.title}</h3>
									<p class="description">{post.data.description}</p>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
			
			<section class="cta">
				<h2>¿Quieres dominar la IA antes que tu competencia?</h2>
				<p>Síguenos en redes para más noticias que importan.</p>
				<div class="cta-buttons">
					<a href="https://instagram.com/wearekod" target="_blank" class="btn primary">
						Seguir en Instagram
					</a>
					<a href="/blog" class="btn secondary">
						Ver todos los artículos
					</a>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		text-align: center;
		padding: 4em 0 3em;
		border-bottom: 1px solid #374151;
		margin-bottom: 3em;
	}
	
	.hero h1 {
		font-size: 3em;
		margin-bottom: 0.25em;
	}
	
	.lightning {
		color: #7C6AEF;
	}
	
	.hero p {
		font-size: 1.25em;
		color: #9CA3AF;
		margin: 0;
	}
	
	.hero .subtitle {
		margin-top: 1em;
		font-size: 1em;
	}
	
	.hero .subtitle a {
		color: #7C6AEF;
	}
	
	.latest-posts h2 {
		font-size: 1.5em;
		margin-bottom: 1.5em;
		color: white;
	}
	
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	
	.post-card {
		display: block;
		padding: 1.5em;
		background: #1A1A1A;
		border: 1px solid #374151;
		border-radius: 12px;
		margin-bottom: 1em;
		text-decoration: none;
		transition: all 0.2s ease;
	}
	
	.post-card:hover {
		border-color: #7C6AEF;
		transform: translateY(-2px);
		box-shadow: 0 4px 20px rgba(124, 106, 239, 0.15);
	}
	
	.category {
		display: inline-block;
		padding: 0.25em 0.75em;
		background: #7C6AEF;
		color: white;
		font-size: 0.75em;
		font-weight: 700;
		text-transform: uppercase;
		border-radius: 4px;
		margin-bottom: 0.75em;
	}
	
	.post-card h3 {
		color: white;
		font-size: 1.25em;
		margin-bottom: 0.5em;
		line-height: 1.3;
	}
	
	.post-card .description {
		color: #9CA3AF;
		font-size: 0.95em;
		margin-bottom: 0.75em;
		line-height: 1.5;
	}
	
	.post-card .date {
		color: #6B7280;
		font-size: 0.85em;
		margin: 0;
	}
	
	.cta {
		text-align: center;
		padding: 4em 2em;
		background: #1A1A1A;
		border-radius: 16px;
		margin-top: 4em;
		border: 1px solid #374151;
	}
	
	.cta h2 {
		font-size: 1.75em;
		color: white;
		margin-bottom: 0.5em;
	}
	
	.cta p {
		color: #9CA3AF;
		margin-bottom: 2em;
	}
	
	.cta-buttons {
		display: flex;
		gap: 1em;
		justify-content: center;
		flex-wrap: wrap;
	}
	
	.btn {
		padding: 0.75em 1.5em;
		border-radius: 8px;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.2s ease;
	}
	
	.btn.primary {
		background: #7C6AEF;
		color: white;
	}
	
	.btn.primary:hover {
		background: #9D8FF2;
	}
	
	.btn.secondary {
		background: transparent;
		color: #7C6AEF;
		border: 2px solid #7C6AEF;
	}
	
	.btn.secondary:hover {
		background: rgba(124, 106, 239, 0.1);
	}
	
	@media (max-width: 720px) {
		.hero h1 {
			font-size: 2em;
		}
		
		.cta h2 {
			font-size: 1.5em;
		}
	}
</style>
