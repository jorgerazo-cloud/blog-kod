---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Featured posts (latest 5 for slider)
const featuredPosts = allPosts.slice(0, 5);

// Get unique categories
const categories = [...new Set(allPosts.map(post => post.data.category).filter(Boolean))];

// Posts by category
const postsByCategory = categories.reduce((acc, cat) => {
	acc[cat] = allPosts.filter(post => post.data.category === cat).slice(0, 4);
	return acc;
}, {} as Record<string, typeof allPosts>);

// Category config
const categoryConfig: Record<string, { icon: string; color: string; gradient: string }> = {
	'IA': { 
		icon: '🤖', 
		color: '#7C6AEF',
		gradient: 'linear-gradient(135deg, #7C6AEF 0%, #5B4BC7 100%)'
	},
	'Negocios': { 
		icon: '💼', 
		color: '#10B981',
		gradient: 'linear-gradient(135deg, #10B981 0%, #059669 100%)'
	},
	'Tech': { 
		icon: '💻', 
		color: '#3B82F6',
		gradient: 'linear-gradient(135deg, #3B82F6 0%, #2563EB 100%)'
	},
	'Marketing': { 
		icon: '📈', 
		color: '#EF4444',
		gradient: 'linear-gradient(135deg, #EF4444 0%, #DC2626 100%)'
	}
};

const getConfig = (cat: string) => categoryConfig[cat] || { 
	icon: '📰', 
	color: '#7C6AEF',
	gradient: 'linear-gradient(135deg, #7C6AEF 0%, #5B4BC7 100%)'
};
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- Breaking News Ticker -->
			<div class="breaking-news">
				<span class="breaking-label">
					<span class="pulse"></span>
					EN VIVO
				</span>
				<div class="ticker-wrapper">
					<div class="ticker">
						{allPosts.slice(0, 8).map((post) => (
							<a href={`/blog/${post.id}/`} class="ticker-item">
								<span class="ticker-cat">{post.data.category}</span>
								{post.data.title}
							</a>
						))}
						{allPosts.slice(0, 8).map((post) => (
							<a href={`/blog/${post.id}/`} class="ticker-item">
								<span class="ticker-cat">{post.data.category}</span>
								{post.data.title}
							</a>
						))}
					</div>
				</div>
			</div>

			<!-- Hero Slider -->
			<section class="hero-slider">
				<div class="hero-glow"></div>
				<div class="slider-container">
					{featuredPosts.map((post, index) => (
						<article class={`slide ${index === 0 ? 'active' : ''}`} data-slide={index}>
							<a href={`/blog/${post.id}/`} class="slide-link">
								<div class="slide-image">
									{post.data.heroImage && (
										<img src={post.data.heroImage} alt={post.data.title} loading={index === 0 ? 'eager' : 'lazy'} />
									)}
									<div class="slide-overlay"></div>
								</div>
								<div class="slide-content">
									<div class="slide-badge">
										<span class="badge-new">NUEVO</span>
										{post.data.category && (
											<span class="slide-category" style={`background: ${getConfig(post.data.category).gradient}`}>
												{getConfig(post.data.category).icon} {post.data.category}
											</span>
										)}
									</div>
									<h2 class="slide-title">{post.data.title}</h2>
									<p class="slide-description">{post.data.description}</p>
									<div class="slide-footer">
										<span class="slide-date">
											<FormattedDate date={post.data.pubDate} />
										</span>
										<span class="slide-cta">Leer artículo →</span>
									</div>
								</div>
							</a>
						</article>
					))}
				</div>
				<div class="slider-controls">
					<button class="slider-arrow prev" aria-label="Anterior">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
					</button>
					<div class="slider-nav">
						{featuredPosts.map((_, index) => (
							<button class={`nav-dot ${index === 0 ? 'active' : ''}`} data-slide={index}>
								<span class="dot-progress"></span>
							</button>
						))}
					</div>
					<button class="slider-arrow next" aria-label="Siguiente">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
					</button>
				</div>
			</section>

			<!-- Quick Stats -->
			<section class="quick-stats">
				<div class="stat-item">
					<span class="stat-number">{allPosts.length}</span>
					<span class="stat-label">Artículos</span>
				</div>
				<div class="stat-divider"></div>
				<div class="stat-item">
					<span class="stat-number">{categories.length}</span>
					<span class="stat-label">Categorías</span>
				</div>
				<div class="stat-divider"></div>
				<div class="stat-item">
					<span class="stat-number">24/7</span>
					<span class="stat-label">Cobertura IA</span>
				</div>
			</section>

			<!-- Category Sections -->
			{categories.map((category) => {
				const config = getConfig(category);
				const posts = postsByCategory[category];
				if (!posts || posts.length === 0) return null;
				
				return (
					<section class="category-section" style={`--cat-color: ${config.color}; --cat-gradient: ${config.gradient}`}>
						<div class="section-header">
							<div class="section-title">
								<span class="section-icon" style={`background: ${config.gradient}`}>
									{config.icon}
								</span>
								<h2>{category}</h2>
								<span class="section-count">{posts.length} artículos</span>
							</div>
							<a href={`/blog?category=${category}`} class="see-all">
								Ver todos
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
							</a>
						</div>
						<div class="category-grid">
							{posts.map((post, index) => (
								<article class={`category-card ${index === 0 ? 'featured' : ''}`}>
									<a href={`/blog/${post.id}/`}>
										<div class="card-image">
											{post.data.heroImage && (
												<img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
											)}
											<div class="card-overlay"></div>
											{index === 0 && <span class="card-badge">Destacado</span>}
										</div>
										<div class="card-content">
											<h3>{post.data.title}</h3>
											<p class="card-desc">{post.data.description}</p>
											<span class="card-date">
												<FormattedDate date={post.data.pubDate} />
											</span>
										</div>
									</a>
								</article>
							))}
						</div>
					</section>
				);
			})}

			<!-- All Latest News -->
			<section class="all-news">
				<div class="section-header">
					<div class="section-title">
						<span class="section-icon pulse-icon">🔥</span>
						<h2>Todas las Noticias</h2>
					</div>
					<a href="/blog" class="see-all">
						Archivo completo
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
					</a>
				</div>
				<div class="news-grid">
					{allPosts.map((post) => (
						<article class="news-card">
							<a href={`/blog/${post.id}/`}>
								<div class="news-image">
									{post.data.heroImage && (
										<img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
									)}
								</div>
								<div class="news-content">
									{post.data.category && (
										<span class="news-category" style={`color: ${getConfig(post.data.category).color}`}>
											{getConfig(post.data.category).icon} {post.data.category}
										</span>
									)}
									<h3>{post.data.title}</h3>
									<span class="news-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</div>
							</a>
						</article>
					))}
				</div>
			</section>

			<!-- CTA Section -->
			<section class="cta-section">
				<div class="cta-glow"></div>
				<div class="cta-content">
					<span class="cta-badge">🚀 Únete a la comunidad</span>
					<h2>La IA no espera. Tú tampoco deberías.</h2>
					<p>Noticias, análisis y tendencias que definen el futuro de los negocios digitales.</p>
					<div class="cta-buttons">
						<a href="https://instagram.com/wearekod" target="_blank" rel="noopener" class="cta-btn primary">
							<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
							Seguir @wearekod
						</a>
						<a href="/blog" class="cta-btn secondary">
							Explorar archivo
						</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			// Slider functionality
			const slides = document.querySelectorAll('.slide');
			const dots = document.querySelectorAll('.nav-dot');
			const prevBtn = document.querySelector('.slider-arrow.prev');
			const nextBtn = document.querySelector('.slider-arrow.next');
			let currentSlide = 0;
			let autoSlideInterval: ReturnType<typeof setInterval>;
			const SLIDE_DURATION = 6000;

			function showSlide(index: number) {
				slides.forEach((slide, i) => {
					slide.classList.toggle('active', i === index);
				});
				dots.forEach((dot, i) => {
					dot.classList.toggle('active', i === index);
				});
				currentSlide = index;
			}

			function nextSlide() {
				const next = (currentSlide + 1) % slides.length;
				showSlide(next);
			}

			function prevSlide() {
				const prev = (currentSlide - 1 + slides.length) % slides.length;
				showSlide(prev);
			}

			function startAutoSlide() {
				autoSlideInterval = setInterval(nextSlide, SLIDE_DURATION);
			}

			function stopAutoSlide() {
				clearInterval(autoSlideInterval);
			}

			dots.forEach((dot, index) => {
				dot.addEventListener('click', () => {
					stopAutoSlide();
					showSlide(index);
					startAutoSlide();
				});
			});

			prevBtn?.addEventListener('click', () => {
				stopAutoSlide();
				prevSlide();
				startAutoSlide();
			});

			nextBtn?.addEventListener('click', () => {
				stopAutoSlide();
				nextSlide();
				startAutoSlide();
			});

			// Touch support
			let touchStartX = 0;
			const slider = document.querySelector('.hero-slider');

			slider?.addEventListener('touchstart', (e: TouchEvent) => {
				touchStartX = e.changedTouches[0].screenX;
			}, { passive: true });

			slider?.addEventListener('touchend', (e: TouchEvent) => {
				const touchEndX = e.changedTouches[0].screenX;
				if (touchStartX - touchEndX > 50) {
					stopAutoSlide();
					nextSlide();
					startAutoSlide();
				} else if (touchEndX - touchStartX > 50) {
					stopAutoSlide();
					prevSlide();
					startAutoSlide();
				}
			}, { passive: true });

			startAutoSlide();
		</script>
	</body>
</html>

<style>
	/* ===== GLOBAL ===== */
	main {
		overflow-x: hidden;
	}

	/* ===== BREAKING NEWS ===== */
	.breaking-news {
		display: flex;
		align-items: center;
		background: #0D0D0D;
		border-bottom: 1px solid rgba(124, 106, 239, 0.3);
		padding: 0.6rem 1rem;
		gap: 1rem;
		overflow: hidden;
	}

	.breaking-label {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 800;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: #EF4444;
	}

	.pulse {
		width: 8px;
		height: 8px;
		background: #EF4444;
		border-radius: 50%;
		animation: pulse 1.5s infinite;
	}

	@keyframes pulse {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.5; transform: scale(1.2); }
	}

	.ticker-wrapper {
		flex: 1;
		overflow: hidden;
		mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
	}

	.ticker {
		display: flex;
		gap: 3rem;
		animation: ticker 60s linear infinite;
		white-space: nowrap;
	}

	.ticker-item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		color: #9CA3AF;
		text-decoration: none;
		font-size: 0.85rem;
		font-weight: 500;
		transition: color 0.2s;
	}

	.ticker-item:hover {
		color: white;
	}

	.ticker-cat {
		font-size: 0.65rem;
		font-weight: 700;
		color: #7C6AEF;
		text-transform: uppercase;
	}

	@keyframes ticker {
		0% { transform: translateX(0); }
		100% { transform: translateX(-50%); }
	}

	/* ===== HERO SLIDER ===== */
	.hero-slider {
		position: relative;
		width: 100%;
		height: 70vh;
		min-height: 400px;
		max-height: 700px;
		overflow: hidden;
		background: #0D0D0D;
	}

	.hero-glow {
		position: absolute;
		top: -50%;
		left: 50%;
		transform: translateX(-50%);
		width: 120%;
		height: 100%;
		background: radial-gradient(ellipse at center, rgba(124, 106, 239, 0.15) 0%, transparent 70%);
		pointer-events: none;
		z-index: 1;
	}

	.slider-container {
		position: relative;
		width: 100%;
		height: 100%;
		z-index: 2;
	}

	.slide {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
		transform: scale(1.02);
		transition: opacity 0.6s ease, transform 0.6s ease;
		pointer-events: none;
	}

	.slide.active {
		opacity: 1;
		transform: scale(1);
		pointer-events: auto;
	}

	.slide-link {
		display: block;
		width: 100%;
		height: 100%;
		text-decoration: none;
	}

	.slide-image {
		position: absolute;
		inset: 0;
	}

	.slide-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.slide-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			135deg,
			rgba(13, 13, 13, 0.95) 0%,
			rgba(13, 13, 13, 0.8) 30%,
			rgba(13, 13, 13, 0.4) 60%,
			rgba(13, 13, 13, 0.3) 100%
		);
	}

	.slide-content {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		padding: 2rem 1.5rem 4rem;
		z-index: 2;
	}

	@media (min-width: 768px) {
		.slide-content {
			padding: 3rem 4rem 5rem;
			max-width: 900px;
		}
	}

	.slide-badge {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1rem;
	}

	.badge-new {
		padding: 0.3rem 0.6rem;
		font-size: 0.6rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		color: #0D0D0D;
		background: #FCD34D;
		border-radius: 4px;
		animation: glow-badge 2s ease-in-out infinite;
	}

	@keyframes glow-badge {
		0%, 100% { box-shadow: 0 0 5px rgba(252, 211, 77, 0.5); }
		50% { box-shadow: 0 0 20px rgba(252, 211, 77, 0.8); }
	}

	.slide-category {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.75rem;
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: white;
		border-radius: 4px;
	}

	.slide-title {
		color: white;
		font-size: 1.75rem;
		font-weight: 800;
		line-height: 1.15;
		margin: 0 0 0.75rem;
		text-shadow: 0 2px 20px rgba(0,0,0,0.5);
	}

	@media (min-width: 768px) {
		.slide-title {
			font-size: 3rem;
		}
	}

	.slide-description {
		color: #D1D5DB;
		font-size: 1rem;
		line-height: 1.6;
		margin: 0 0 1rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	@media (min-width: 768px) {
		.slide-description {
			font-size: 1.15rem;
			-webkit-line-clamp: 3;
		}
	}

	.slide-footer {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.slide-date {
		color: #6B7280;
		font-size: 0.85rem;
	}

	.slide-cta {
		color: #7C6AEF;
		font-weight: 600;
		font-size: 0.9rem;
		transition: color 0.2s;
	}

	.slide-link:hover .slide-cta {
		color: #A78BFA;
	}

	/* Slider Controls */
	.slider-controls {
		position: absolute;
		bottom: 1.5rem;
		right: 1.5rem;
		display: flex;
		align-items: center;
		gap: 1rem;
		z-index: 10;
	}

	@media (min-width: 768px) {
		.slider-controls {
			bottom: 2.5rem;
			right: 3rem;
		}
	}

	.slider-arrow {
		width: 40px;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255,255,255,0.1);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255,255,255,0.1);
		border-radius: 50%;
		color: white;
		cursor: pointer;
		transition: all 0.2s;
	}

	.slider-arrow:hover {
		background: rgba(124, 106, 239, 0.5);
		border-color: #7C6AEF;
	}

	.slider-arrow svg {
		width: 20px;
		height: 20px;
	}

	.slider-nav {
		display: flex;
		gap: 0.5rem;
	}

	.nav-dot {
		width: 24px;
		height: 4px;
		border-radius: 2px;
		background: rgba(255,255,255,0.2);
		border: none;
		cursor: pointer;
		overflow: hidden;
		transition: all 0.3s;
		position: relative;
	}

	.nav-dot.active {
		width: 40px;
		background: rgba(255,255,255,0.3);
	}

	.dot-progress {
		position: absolute;
		left: 0;
		top: 0;
		height: 100%;
		width: 0;
		background: #7C6AEF;
		border-radius: 2px;
	}

	.nav-dot.active .dot-progress {
		animation: progress 6s linear forwards;
	}

	@keyframes progress {
		0% { width: 0; }
		100% { width: 100%; }
	}

	/* ===== QUICK STATS ===== */
	.quick-stats {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 2rem;
		padding: 1.5rem 1rem;
		background: linear-gradient(180deg, #0D0D0D 0%, #1A1A1A 100%);
		border-bottom: 1px solid #374151;
	}

	@media (min-width: 768px) {
		.quick-stats {
			gap: 4rem;
			padding: 2rem;
		}
	}

	.stat-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
	}

	.stat-number {
		font-size: 1.5rem;
		font-weight: 800;
		color: #7C6AEF;
	}

