---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ShareButtons from '../components/ShareButtons.astro';
import AuthorCard from '../components/AuthorCard.astro';
import TableOfContents from '../components/TableOfContents.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';

type Props = CollectionEntry<'blog'>['data'] & {
  headings: Array<{ depth: number; slug: string; text: string }>;
  slug: string;
  rawContent: string;
};

const { title, description, pubDate, updatedDate, heroImage, headings, slug, rawContent, category, tags } = Astro.props;

// Calculate reading time
const words = rawContent?.split(/\s+/).length || 0;
const readingTime = Math.ceil(words / 200);

const fullUrl = `https://blog.wearekod.com/blog/${slug}/`;

// Map category to section
const sectionMap: Record<string, string> = {
  'IA': 'Inteligencia Artificial',
  'Negocios': 'Negocios',
  'Tech': 'Tecnología',
  'Marketing': 'Marketing Digital'
};
const section = category ? sectionMap[category] || category : 'Tecnología';
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead 
      title={`${title} | Blog KÖD`} 
      description={description} 
      image={heroImage}
      type="article"
      publishedTime={pubDate}
      modifiedTime={updatedDate}
      author="KÖD Editorial"
      section={section}
      tags={tags || [category || 'IA', 'tecnología', 'noticias']}
      slug={slug}
    />
    <style>
      /* Hero Section - Compact */
      .hero {
        position: relative;
        width: 100%;
        min-height: 35vh;
        display: flex;
        align-items: flex-end;
        overflow: hidden;
      }

      @media (min-width: 768px) {
        .hero {
          min-height: 50vh;
        }
      }

      .hero-image {
        position: absolute;
        inset: 0;
        z-index: 0;
      }

      .hero-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to top,
          rgba(13, 13, 13, 1) 0%,
          rgba(13, 13, 13, 0.95) 40%,
          rgba(13, 13, 13, 0.6) 80%,
          rgba(13, 13, 13, 0.3) 100%
        );
        z-index: 1;
      }

      .hero-content {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        padding: 1.5rem 1rem;
      }

      @media (min-width: 768px) {
        .hero-content {
          padding: 3rem 2rem;
        }
      }

      .hero-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
      }

      @media (min-width: 768px) {
        .hero-meta {
          gap: 1rem;
          margin-bottom: 1.5rem;
        }
      }

      .hero-date {
        color: #7C6AEF;
        font-size: 0.875rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .hero-reading-time {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        color: #888;
        font-size: 0.875rem;
      }

      .hero-reading-time svg {
        width: 16px;
        height: 16px;
      }

      .hero-title {
        font-size: 1.5rem;
        font-weight: 800;
        line-height: 1.2;
        color: white;
        margin: 0 0 0.5rem;
      }

      @media (min-width: 768px) {
        .hero-title {
          font-size: clamp(2rem, 5vw, 3.5rem);
          line-height: 1.1;
          margin: 0 0 1rem;
        }
      }

      .hero-description {
        font-size: 1rem;
        color: #ccc;
        line-height: 1.5;
        max-width: 700px;
        display: none;
      }

      @media (min-width: 768px) {
        .hero-description {
          display: block;
          font-size: 1.25rem;
          line-height: 1.6;
        }
      }

      /* Main Layout */
      .article-layout {
        display: flex;
        flex-direction: column;
        max-width: 720px;
        margin: 0 auto;
        padding: 1.5rem 1rem;
      }

      @media (min-width: 768px) {
        .article-layout {
          padding: 3rem 1rem;
        }
      }

      @media (min-width: 1200px) {
        .article-layout {
          display: flex;
          flex-direction: row;
          max-width: 1100px;
          gap: 3rem;
          padding: 3rem 2rem;
        }
      }

      .article-sidebar-left {
        display: none;
      }

      .article-content {
        flex: 1;
        min-width: 0;
        max-width: 720px;
      }

      .article-sidebar-right {
        display: none;
      }

      @media (min-width: 1200px) {
        .article-sidebar-right {
          display: block;
          width: 280px;
          flex-shrink: 0;
        }
      }

      /* Prose Styles */
      .prose {
        color: #e0e0e0;
        font-size: 1rem;
        line-height: 1.7;
      }

      @media (min-width: 768px) {
        .prose {
          font-size: 1.125rem;
          line-height: 1.8;
        }
      }

      .prose :global(h2) {
        font-size: 1.35rem;
        font-weight: 700;
        color: white;
        margin: 2rem 0 0.75rem;
        scroll-margin-top: 2rem;
      }

      @media (min-width: 768px) {
        .prose :global(h2) {
          font-size: 1.75rem;
          margin: 3rem 0 1rem;
        }
      }

      .prose :global(h3) {
        font-size: 1.15rem;
        font-weight: 600;
        color: white;
        margin: 1.5rem 0 0.5rem;
        scroll-margin-top: 2rem;
      }

      @media (min-width: 768px) {
        .prose :global(h3) {
          font-size: 1.375rem;
          margin: 2rem 0 0.75rem;
        }
      }

      .prose :global(p) {
        margin: 1rem 0;
      }

      @media (min-width: 768px) {
        .prose :global(p) {
          margin: 1.5rem 0;
        }
      }

      .prose :global(a) {
        color: #7C6AEF;
        text-decoration: underline;
        text-decoration-color: rgba(124, 106, 239, 0.3);
        text-underline-offset: 3px;
        transition: text-decoration-color 0.2s;
      }

      .prose :global(a:hover) {
        text-decoration-color: #7C6AEF;
      }

      .prose :global(strong) {
        color: white;
        font-weight: 600;
      }

      .prose :global(blockquote) {
        margin: 2rem 0;
        padding: 1.5rem 2rem;
        background: rgba(124, 106, 239, 0.08);
        border-left: 4px solid #7C6AEF;
        border-radius: 0 12px 12px 0;
        font-style: italic;
        color: #ccc;
      }

      .prose :global(blockquote p) {
        margin: 0;
      }

      .prose :global(ul), .prose :global(ol) {
        margin: 1.5rem 0;
        padding-left: 1.5rem;
      }

      .prose :global(li) {
        margin: 0.5rem 0;
      }

      .prose :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: 12px;
        margin: 2rem 0;
      }

      .prose :global(pre) {
        background: rgba(0, 0, 0, 0.5);
        border: 1px solid rgba(124, 106, 239, 0.2);
        border-radius: 12px;
        padding: 1.5rem;
        overflow-x: auto;
        margin: 2rem 0;
      }

      .prose :global(code) {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.9em;
      }

      .prose :global(:not(pre) > code) {
        background: rgba(124, 106, 239, 0.15);
        padding: 0.2em 0.4em;
        border-radius: 4px;
        color: #7C6AEF;
      }

      /* Updated Date */
      .updated-date {
        font-size: 0.875rem;
        color: #888;
        font-style: italic;
        margin-bottom: 2rem;
      }

      /* Mobile TOC - Collapsible */
      .mobile-toc {
        display: none;
      }

      @media (min-width: 1200px) {
        .mobile-toc {
          display: none;
        }
      }

      /* Author section */
      .author-section {
        margin-top: 3rem;
      }
    </style>
  </head>

  <body>
    <Header />
    
    <main>
      <!-- Hero Section -->
      <section class="hero">
        {heroImage && (
          <div class="hero-image">
            <img src={heroImage} alt="" />
          </div>
        )}
        <div class="hero-overlay"></div>
        <div class="hero-content">
          <div class="hero-meta">
            <span class="hero-date">
              <FormattedDate date={pubDate} />
            </span>
            <span class="hero-reading-time">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 6v6l4 2"/>
              </svg>
              {readingTime} min de lectura
            </span>
          </div>
          <h1 class="hero-title">{title}</h1>
          {description && <p class="hero-description">{description}</p>}
        </div>
      </section>

      <!-- Article Layout -->
      <div class="article-layout">
        <aside class="article-sidebar-left"></aside>
        
        <article class="article-content">
          {updatedDate && (
            <p class="updated-date">
              Última actualización: <FormattedDate date={updatedDate} />
            </p>
          )}

          <!-- Mobile TOC -->
          <div class="mobile-toc">
            <TableOfContents headings={headings} />
          </div>

          <!-- Share Buttons Top -->
          <ShareButtons title={title} url={fullUrl} />

          <!-- Article Content -->
          <div class="prose">
            <slot />
          </div>

          <!-- Share Buttons Bottom -->
          <ShareButtons title={title} url={fullUrl} />

          <!-- Author Card -->
          <div class="author-section">
            <AuthorCard />
          </div>

          <!-- Newsletter -->
          <NewsletterSignup />

          <!-- Related Posts -->
          <RelatedPosts currentSlug={slug} />
        </article>

        <aside class="article-sidebar-right">
          <TableOfContents headings={headings} />
        </aside>
      </div>
    </main>

    <Footer />
  </body>
</html>
